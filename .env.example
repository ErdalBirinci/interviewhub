# InterviewHub — ortam değişkenleri
# Kopyalayın:  cp .env.example .env

# --- Sunucu ---
PORT=4000
# API + statik web'in çalıştığı adres (oda/giriş bağlantıları bununla kurulur)
PUBLIC_URL=http://localhost:4000
# Vite geliştirme sunucusu (derlenmiş web yoksa bağlantılar buraya gider)
WEB_URL=http://localhost:5173

# Token imzalama anahtarı — üretimde MUTLAKA değiştirin:  openssl rand -hex 32
SESSION_SECRET=interviewhub-gelistirme-secreti

# --- LinkedIn OAuth ---
# Boş bırakılırsa LinkedIn girişi devre dışı, demo girişi aktif kalır.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# --- TURN sunucusu (opsiyonel; simetrik NAT için gerekli) ---
# TURN_URL=
# TURN_USERNAME=
# TURN_CREDENTIAL=

# --- STUN sunucuları (varsayılan: Google) ---
# STUN_SERVERS=stun:stun.l.google.com:19302
